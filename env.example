# Copy this file to .env.local and fill in the real values from the
# Supabase project dashboard (Project Settings -> API).
# NEVER commit .env.local and NEVER hardcode real keys in source code.

# Fourth Code production Supabase project (URL is not a secret; the keys are).
NEXT_PUBLIC_SUPABASE_URL=https://vkzjhyouzdlyhtailtas.supabase.co

# Supabase "anon public" API key (safe to expose in the browser; row level
# security in the database is what protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Optional: platform fee as a percentage of each booking (monetization is
# a percentage cut per booking — no subscription or account fees).
# Defaults to 12 when unset. The single source of truth in code is
# PLATFORM_FEE_PERCENT in src/lib/config.ts.
# PLATFORM_FEE_PERCENT=12
